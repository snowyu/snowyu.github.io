// Vendored from https://github.com/theme-next/hexo-theme-next-anchor (unpublished
// from npm on 2022-09-13). Injected by scripts/heading-anchor.js via NexT's
// `theme_inject` style point; reads the `anchor:` block of source/_data/next.yml.
icon_enable = hexo-config('anchor.icon.enable');
anchor_position = hexo-config('anchor.position');
margin = unquote(hexo-config('anchor.margin'));

.heading-anchor {
  if anchor_position == 'right' {
    display: none;
    margin-left: margin;
  } else if anchor_position == 'left' {
    margin-right: margin;
  }
  &:before {
    if icon_enable {
      font-family: hexo-config('anchor.icon.font');
      content: hexo-config('anchor.icon.content');
    } else {
      content: hexo-config('anchor.text');
    }
  }
  .heading-control:hover & {
    display: inline-block;
  }
}

a.heading-anchor {
  color: unquote(hexo-config('anchor.color'));
  line-height: 0;
  border-bottom: none;
}
